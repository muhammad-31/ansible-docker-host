# {{ ansible_managed }}
{% set cert_dir = ('/etc/letsencrypt/live/' ~ item.name) if reverse_proxy_letsencrypt_enabled | bool else ('/etc/ssl/reverse-proxy/' ~ item.name) %}
upstream {{ item.name }}_upstream {
    server {{ item.upstream | regex_replace('^https?://', '') }};
    keepalive 16;
}

server {
    listen 80;
{% if reverse_proxy_ipv6 | bool %}
    listen [::]:80;
{% endif %}
    server_name {{ item.server_names | join(' ') }};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # "listen ... http2" rather than "http2 on": Ubuntu 22.04/24.04 ship Nginx < 1.25.1.
    listen 443 ssl http2;
{% if reverse_proxy_ipv6 | bool %}
    listen [::]:443 ssl http2;
{% endif %}
    server_name {{ item.server_names | join(' ') }};

    ssl_certificate     {{ cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ cert_dir }}/privkey.pem;

    include snippets/security-headers.conf;

    location / {
        limit_req zone=per_ip burst={{ reverse_proxy_rate_limit_burst }} nodelay;
        include snippets/proxy.conf;
        proxy_pass {{ item.upstream | regex_replace('^(https?)://.*$', '\\1') }}://{{ item.name }}_upstream;
    }
}
