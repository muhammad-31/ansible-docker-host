// {{ ansible_managed }}
// Security updates only (the Ubuntu default origins), plus cleanup.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Automatic-Reboot "{{ base_unattended_upgrades_reboot | bool | lower }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ base_unattended_upgrades_reboot_time }}";
