# {{ ansible_managed }}
# Sourced by bash, so every value is shell-quoted: passwords may contain
# spaces, quotes, $ or ; without breaking the backup or running anything.
RESTIC_REPOSITORY={{ backups_restic_repository | quote }}
RESTIC_PASSWORD={{ backups_restic_password | quote }}
{% for key, value in backups_env.items() %}
{{ key }}={{ value | string | quote }}
{% endfor %}
