# {{ ansible_managed }}
[DEFAULT]
backend = systemd
bantime = {{ hardening_fail2ban_bantime }}
findtime = {{ hardening_fail2ban_findtime }}
maxretry = {{ hardening_fail2ban_maxretry }}
banaction = ufw

[sshd]
enabled = true
port = {{ hardening_ssh_port }}

# Ban repeat offenders for a week.
[recidive]
enabled = true
backend = auto
logpath = /var/log/fail2ban.log
bantime = 1w
findtime = 1d
maxretry = 3
